{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "modules": [
    "os",
    "chassis",
    "cpu",
    "gpu",
    "memory",
    "separator",
    { "type": "display", "key": "Display {index}" },
    { "type": "physicaldisk", "key": "Physical Disk {index}", "format": "{size} [{physical-type}, {interconnect}]" },
    "separator",
    "uptime",
    "locale"
  ]
}
